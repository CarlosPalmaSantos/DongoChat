{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "types": [
      "node"
    ],
    "moduleResolution": "Bundler",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ]
}
